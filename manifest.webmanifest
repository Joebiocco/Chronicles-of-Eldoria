{
  "id": "./",
  "name": "Chronicles of Eldoria — The Memory Beneath",
  "short_name": "Eldoria",
  "description": "A world-driven idle role-playing game with 35 skills, staged narrative quests, branching dungeons, combat automation, world-changing choices, and offline progression.",
  "lang": "en-US",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#120e0a",
  "theme_color": "#21170f",
  "categories": [
    "games",
    "role-playing",
    "entertainment"
  ],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/icons/maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "World Map",
      "short_name": "Map",
      "description": "Open Eldoria’s interactive world map.",
      "url": "./?view=map",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Skills",
      "short_name": "Skills",
      "description": "Open the skill and production interface.",
      "url": "./?view=skills",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Combat",
      "short_name": "Combat",
      "description": "Open combat areas, Slayer assignments, and automation.",
      "url": "./?view=combat",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Bank",
      "short_name": "Bank",
      "description": "Open inventory, equipment, bank, and loadouts.",
      "url": "./?view=bank",
      "icons": [
        {
          "src": "./assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "./assets/screenshot-wide.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard, world event, quests, passive systems, and activity controls."
    },
    {
      "src": "./assets/screenshot-map.png",
      "sizes": "1440x1000",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Interactive Eldoria map with region nodes, resource overlay, discoveries, quests, weather, and travel information."
    },
    {
      "src": "./assets/screenshot-mobile.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Phone layout with touch navigation, safe-area spacing, and responsive world dashboard."
    }
  ]
}
